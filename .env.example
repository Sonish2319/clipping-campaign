# ==============================================================================
# YouTube Creator Campaign & Clip Marketplace Environment Configuration
# ==============================================================================

# Application & Environment
APP_NAME="YouTube Campaign Marketplace"
APP_ENV=development
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security Secrets
# Generate random 32+ char strings for production
SECRET_KEY=dev_secret_key_change_me_super_secure_and_long_jwt_signing_key_32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet Key for encrypting OAuth tokens at rest (32 url-safe base64-encoded bytes)
# Generated sample key for development:
FERNET_ENCRYPTION_KEY=dGhpcy1pcy1hLXNhbXBsZS1mZXJuZXQta2V5LTMyYnl0ZXM9

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=campaign_db
MYSQL_USER=campaign_user
MYSQL_PASSWORD=campaign_password
MYSQL_ROOT_PASSWORD=campaign_root_secret
DATABASE_URL=mysql+pymysql://campaign_user:campaign_password@localhost:3306/campaign_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google OAuth & YouTube Integration
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/editor/channels/callback
YOUTUBE_API_KEY=your_youtube_api_key_here

# Initial Superadmin Configuration (for seed script)
SUPERADMIN_EMAIL=admin@campaignmarketplace.com
SUPERADMIN_NAME="System Superadmin"
SUPERADMIN_PASSWORD=AdminSecretPass123!

# YouTube Polling Frequency (Minutes)
VIDEO_POLLING_INTERVAL_MINUTES=3

# AI Assistant & RAG Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:latest
QDRANT_HOST=localhost
QDRANT_PORT=6333
