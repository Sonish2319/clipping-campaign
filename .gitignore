# ==========================================
# Root .gitignore for Campaign Marketplace
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.env
*.local

# ------------------------------------------
# Python / Backend
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Test Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.tox/
.nox/

# Celery task runner & PID files
celerybeat-schedule
celerybeat.pid
*.pid

# Database files & local volume storage
*.sqlite
*.sqlite3
*.db
mysql_data/
redis_data/

# ------------------------------------------
# Node.js / Next.js Frontend
# ------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Next.js build output & static export
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/

# TypeScript & Cache
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.turbo/
.vercel/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors & IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Application logs
logs/
*.log
