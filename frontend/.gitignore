# ==========================================
# Frontend .gitignore (Next.js / TypeScript)
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Production / Build output
.next/
out/
build/
dist/

# TypeScript Build Info
*.tsbuildinfo

# Debug & Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Vercel / Turborepo
.vercel/
.turbo/

# OS metadata
.DS_Store
Thumbs.db
